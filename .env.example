# ---- External data source (called ONLY from the server) ----
# Defaults to the public Harry Potter API. Override for mirrors / testing.
HP_API_BASE_URL=https://hp-api.onrender.com/api

# ============================================================================
#  Chat with the characters — powered by Ollama (optional)
# ============================================================================
# Replies are generated by a model that Ollama runs for us, so there is no
# third-party LLM service and no API key anywhere in this project.
#
# Locally:            install https://ollama.com, then `ollama pull llama3.2:1b`
# With Docker Compose: nothing to do, the stack starts Ollama and pulls the model
#
# Defaults are http://127.0.0.1:11434 and llama3.2:1b, so local development
# needs no configuration at all. docker-compose.yml overrides the URL to reach
# the `ollama` service instead.
OLLAMA_BASE_URL=
OLLAMA_MODEL=
# How long Ollama keeps the model in RAM after a reply (default 15m).
OLLAMA_KEEP_ALIVE=

# ============================================================================
#  Bonus: Supabase live feed (optional)
# ============================================================================
# Create a project at https://supabase.com, run supabase/schema.sql in the SQL
# editor, then paste the project URL and the service_role key (server-only —
# it is never sent to the browser because every call goes through /api/*).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: protects POST /api/sync (exports hp-api data into Supabase).
SYNC_SECRET=
