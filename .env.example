# ---- External data source (called ONLY from the server) ----
# Defaults to the public Harry Potter API. Override for mirrors / testing.
HP_API_BASE_URL=https://hp-api.onrender.com/api

# ============================================================================
#  Bonus: chat with the characters (optional — the app works fully without it)
# ============================================================================
# Two backends are supported and auto-detected in this order:
#
#   1. LLM_BASE_URL is set     -> any OpenAI-compatible /chat/completions server
#   2. ANTHROPIC_API_KEY is set -> Anthropic Claude
#   3. neither                  -> chat is disabled and shows a setup notice
#
# ---- Option A: a LOCAL model, no API key and no bills ----
# Install Ollama (https://ollama.com), then:  ollama pull llama3.2:1b
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2:1b
#
# ---- Option B: a hosted OpenAI-compatible gateway (Groq, OpenRouter, ...) ----
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_API_KEY=gsk_...
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# ---- Option C: Anthropic Claude ----
ANTHROPIC_API_KEY=
# Optional override. Defaults to claude-opus-5.
ANTHROPIC_MODEL=

# ============================================================================
#  Bonus: Supabase live feed (optional)
# ============================================================================
# Create a project at https://supabase.com, run supabase/schema.sql in the SQL
# editor, then paste the project URL and the service_role key (server-only —
# it is never sent to the browser because every call goes through /api/*).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: protects POST /api/sync (exports hp-api data into Supabase).
SYNC_SECRET=
